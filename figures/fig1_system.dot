digraph A{
rankdir=TB; compound=true; nodesep=0.25; ranksep=0.35; fontname="Helvetica";
node[shape=box,style="rounded,filled",fontname="Helvetica",fontsize=10,fillcolor="white",color="#555555"];
edge[fontname="Helvetica",fontsize=8,color="#555555"];

subgraph cluster_in{label="1. Inputs and research question";style="rounded,filled";fillcolor="#eef3fb";color="#7a9cc9";fontsize=11;
 gap[label="Gap: can model-based signals\nfind benchmark shortcuts\nbetter than simple statistics?"];
 hyp[label="Hypotheses (pre-registered)\nH1 sufficiency > best baseline by 0.05\nH2 SHAP adds 0.05 over sufficiency"];
 data[label="Benchmarks\nCICIoT2023, Edge-IIoTset,\nCICIoMT2024"];
 gap->hyp;}

subgraph cluster_gov{label="2. Governance and integrity controls";style="rounded,filled";fillcolor="#f3f0fa";color="#9b8bc4";fontsize=11;
 pilot[label="Pilot\n(CICIoT2023, LightGBM)"];
 prereg[label="Pre-registration\nsignals, plants, thresholds,\nmargins, failure criteria"];
 freeze[label="Freeze log\nSHA-256 of protocol, code,\ndecoy configs, data pools"];
 once[label="Rules: evaluation seeds run once,\nall runs logged,\nno hand-typed numbers"];
 pilot->prereg->freeze->once;}

subgraph cluster_exp{label="3. Experiment engine (one benchmark x model x seed)";style="rounded,filled";fillcolor="#fdf3e6";color="#d9a35b";fontsize=11;
 samp[label="Stratified sample\nand 75/25 split"];
 plant[label="Shortcut injection\nFamily A, Family B, hard decoys,\nclean, Tier 2 real",fillcolor="#fbdcb8"];
 grp[label="Feature grouping\n|Pearson r|, average linkage,\ncut 0.10"];
 mod[label="Models\nLightGBM, random forest, MLP"];
 sig[label="Model-based signals\nS sufficiency, C SHAP share,\nA = C x S, R necessity, T transfer",fillcolor="#d8efdc"];
 base[label="Data-level baselines\ncorrelation ratio,\nmutual information, RFE rank",fillcolor="#d8efdc"];
 samp->plant->grp->mod->sig; grp->base;}

subgraph cluster_dec{label="4. Decision and statistics";style="rounded,filled";fillcolor="#eaf5ee";color="#6fae85";fontsize=11;
 cal[label="Calibration seeds 1001-1010\nclean groups -> 95th-percentile\nthreshold per signal"];
 evals[label="Evaluation seeds 2001-2030\n(MLP: 2001-2015)"];
 met[label="Metrics\ndetection AUC, TPR at threshold,\nclean false alarms, decoy flags,\nTier 2 recovery"];
 stat[label="Paired bootstrap (10,000)\n+ Holm over 9 combinations"];
 rule[label="Apply pre-registered rules\nto H1 and H2"];
 cal->evals->met->stat->rule;}

subgraph cluster_rep{label="5. Results";style="rounded,filled";fillcolor="#fdeaea";color="#c98080";fontsize=11;
 r1[label="H1 not supported\nS beat best baseline (MI) by 0.05\nin 0 of 9 combinations"];
 r2[label="H2 not supported\nSHAP concentration added 0.05\nover S in 0 of 9 combinations"];
 r3[label="Documented Edge-IIoTset artifacts\ncorrelation ratio found all four (TPR 1.0);\nS, C, A, MI, RFE found none (TPR 0.0)"];
 r4[label="Controls\nfalse alarms 0.028-0.073;\n90th-percentile decoy flagged by S\nin 3 of 27 cells"];
 r1->r2->r3->r4;}

hyp->prereg; data->samp; once->cal[constraint=false]; 
freeze->samp[xlabel="frozen before any run",constraint=false];
sig->cal; base->cal; 
rule->r1[ltail=cluster_dec,lhead=cluster_rep];
}
